[resource]
script = ExtResource("1_lmcqa")
id = "Aether_031"
card_name = "移形换位"
element = "以太"
description = "从卡包随机展示3张牌，选择1张替换任意一个当前未激活的副槽卡牌。"
cost_aether = 2
main_type = "utility"
